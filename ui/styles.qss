/* SDDM Theme Manager - Modern DE-Agnostic Stylesheet */

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Main Window & Containers */
QMainWindow {
    background-color: #1a1b26;
    color: #c0caf5;
}

QSplitter::handle {
    background-color: #24283b;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #7aa2f7;
}

/* Toolbar */
QToolBar {
    background-color: #1f2335;
    border-bottom: 1px solid #292e42;
    padding: 6px 12px;
    spacing: 8px;
}

QToolButton {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #2f354f;
    border-color: #7aa2f7;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #3b4261;
}

/* Inputs & Search */
QLineEdit {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 200px;
    selection-background-color: #7aa2f7;
    selection-color: #1a1b26;
}

QLineEdit:focus {
    border-color: #7aa2f7;
    background-color: #1f2335;
}

QComboBox {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 90px;
}

QComboBox:hover {
    border-color: #7aa2f7;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1f2335;
    color: #c0caf5;
    border: 1px solid #3b4261;
    selection-background-color: #3b4261;
    selection-color: #ffffff;
    padding: 4px;
}

/* Push Buttons */
QPushButton {
    background-color: #24283b;
    color: #c0caf5;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2f354f;
    border-color: #7aa2f7;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #3b4261;
}

QPushButton:disabled {
    background-color: #1f2335;
    color: #565f89;
    border-color: #292e42;
}

/* Primary Action Button (Apply) */
QPushButton#primaryBtn {
    background-color: #3d59a1;
    color: #ffffff;
    border: 1px solid #7aa2f7;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* Preview Running Button */
QPushButton#previewActiveBtn {
    background-color: #f7768e;
    color: #ffffff;
    border: 1px solid #ff9eaf;
    font-weight: 600;
}

QPushButton#previewActiveBtn:hover {
    background-color: #db4b4b;
}

/* Danger Button (Remove) */
QPushButton#dangerBtn {
    background-color: transparent;
    color: #f7768e;
    border: 1px solid #f7768e;
}

QPushButton#dangerBtn:hover {
    background-color: #f7768e;
    color: #ffffff;
}

/* Scroll Areas */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: #1a1b26;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3b4261;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #7aa2f7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Detail Panel */
QFrame#detailPanel {
    background-color: #1f2335;
    border-left: 1px solid #292e42;
}

QLabel#themeTitle {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#themeDesc {
    font-size: 12px;
    color: #9aa5ce;
    line-height: 1.4;
}

/* Status Bar */
QStatusBar {
    background-color: #16161e;
    color: #7aa2f7;
    border-top: 1px solid #292e42;
    padding: 4px 10px;
    font-size: 12px;
}

/* Notification Banner */
QFrame#warningBanner {
    background-color: #2e2a1e;
    border-bottom: 1px solid #e0af68;
    padding: 8px 16px;
}

QLabel#warningText {
    color: #e0af68;
    font-weight: 600;
}
